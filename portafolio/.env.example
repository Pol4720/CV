# ============================================================
# Portfolio — Environment variables
# Copy this file to .env.local for local development,
# or set these in your Vercel project (Settings → Environment Variables).
# ============================================================

# Password for the admin panel (/es/admin or /en/admin).
# Choose a strong password. Without it, the admin panel shows "not configured".
ADMIN_PASSWORD=change-me-to-a-strong-password

# Vercel Blob storage token — used to persist uploaded documents.
# In Vercel: Storage → create a Blob store → it is added automatically as
# BLOB_READ_WRITE_TOKEN. For local testing you can paste the token here.
BLOB_READ_WRITE_TOKEN=
